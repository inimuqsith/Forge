# /usr/share/forge/forge.conf.default & /etc/forge/forge.conf
# Konfigurasi Standar Paten Forge Package Manager untuk Kura Linux (Canonical Distro Config)

[general]
# Target root filesystem (default: "/" untuk sistem hidup)
root = "/"

# Lokasi penyimpanan database paket terpasang
db_path = "/var/db/forge"

# Lokasi cache berkas tarball sumber dan binari
cache_path = "/var/cache/forge/distfiles"

# Lokasi build sementara berbasis RAM (tmpfs)
build_path = "/tmp/forge/build"

# Lokasi staging sementara sebelum merge
stage_path = "/tmp/forge/stage"

# Lokasi pohon resep lokal (disinkronisasi dari server)
recipes_path = "/var/db/forge/recipes"

# Mode Resolusi Paket Bawaan:
# - "source": (DEFAULT - Gentoo Portage Mode) Kompilasi 100% native dari kode sumber upstream
# - "binhost": 3-Tier Cascade (Forge Binhost -> CachyOS Zen4/v4/v3 Fallback -> Native Source Fallback)
# - "interactive": Tanyakan opsi provider kepada pengguna saat instalasi
mode = "source"

[server]
# URL Forge Central Server untuk sinkronisasi resep & katalog
recipe_server = "https://pkgkura.amqs.net/v1"

# URL Forge Central Binary Library (Binhost)
binhost_url = "https://pkgkura.amqs.net/v1"

[binhost]
# Opsi akselerasi unduh binary native dari Forge Server (Default: false, diaktifkan via --binhost)
enable_binhost = false

# Otomatis cocokkan paket biner dengan arsitektur CPU pengguna
auto_match_cpu = true

# Otomatis fallback ke kompilasi lokal jika biner tidak ditemukan di server
fallback_to_source = true

[hybrid]
# Fallback opsional ke repositori biner teroptimasi CachyOS (x86-64-v4 / v3 / znver4)
enable_cachyos_fallback = false
cachyos_repo_url = "https://cdn77.cachyos.org/repo/x86_64_v4/cachyos-v4"

# Fallback opsional ke repositori biner standar Arch Linux
enable_arch_fallback = false
arch_repo_url = "https://geo.mirror.pkgbuild.com/core/os/x86_64"

[cpu]
# Target arsitektur CPU (otomatis diisi dari `forge cpu-dump`)
target_march = "native"
enable_avx512 = true
enable_avx2 = true
profile_file = "/etc/forge/cpu-profile.json"

[build]
# Flag optimasi native kompilasi Kura Linux (Level Mentok Ekstrem Silikon Zen 4, Thin LTO & Mold)
cflags = "-O3 -march=native -pipe -flto=thin -fno-plt -fno-math-errno -fno-trapping-math -ffunction-sections -fdata-sections -falign-functions=32 -fstack-protector-strong -D_FORTIFY_SOURCE=2"
cxxflags = "-O3 -march=native -pipe -flto=thin -fno-plt -fno-math-errno -fno-trapping-math -ffunction-sections -fdata-sections -falign-functions=32 -fstack-protector-strong -D_FORTIFY_SOURCE=2"
ldflags = "-Wl,-O3 -Wl,--as-needed -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,now"
makeflags = "-j$(nproc)"
jobs = "auto"
prefix = "/usr"
enable_ccache = true
ccache_dir = "/var/cache/forge/ccache"

[use]
# USE Flags Global ala Portage (fitur yang diaktifkan/dinonaktifkan secara global)
flags = "ssl openrc alsa -systemd lto pgo"

[hooks]
# Integrasi OpenRC & pemicu post-install
enable_openrc_hooks = true
enable_ldconfig_hooks = true
enable_mandoc_hooks = true
auto_prompt_services = true
